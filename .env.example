# ===================================================================
# Najot Ta'lim Landing Page - Telegram Bot Konfiguratsiyasi
# ===================================================================

# 1. Telegram Bot Token (@BotFather orqali olingan token)
# Misol: 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Telegram Chat ID (Shaxsiy profilingiz yoki guruh ID raqami)
# ID raqamingizni Telegramdagi @userinfobot orqali bilib olishingiz mumkin
# Misol: 987654321 yoki guruh bo'lsa: -1001234567890
TELEGRAM_CHAT_ID=your_chat_id_here

# 3. Server Porti (Ixtiyoriy, default: 3000)
PORT=3000
